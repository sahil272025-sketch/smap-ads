# GEMINI_API_KEY: Injected by AI Studio if needed
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. Render production URL)
APP_URL="https://smap-ads.onrender.com"

# DATABASE_URL: Database connection string (optional; file-based fallback used if omitted)
DATABASE_URL="file:./data/smap.db"

# GOOGLE_CLIENT_ID: Google Cloud OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID="989765718508-t8crqu5je34utcjeblsmt33nfkqj4iol.apps.googleusercontent.com"

# GOOGLE_CLIENT_SECRET: Google Cloud OAuth 2.0 Web Client Secret (Set in Render Dashboard -> Environment)
GOOGLE_CLIENT_SECRET=""

# GOOGLE_REDIRECT_URI: Google Cloud OAuth Authorized Redirect URI
GOOGLE_REDIRECT_URI="https://smap-ads.onrender.com/api/auth/google/callback"

# ADMIN_EMAILS: Comma-separated list of Google account emails with admin access
ADMIN_EMAILS="sahilking17341734@gmail.com"

# UPI_MERCHANT_ID: UPI Merchant VPA address
UPI_MERCHANT_ID="sahil-stp@ybl"

# UPI_MERCHANT_NAME: UPI Merchant Display Name
UPI_MERCHANT_NAME="SMAP"

# PAYMENT_PROVIDER: Gateway provider ("razorpay" or "cashfree")
PAYMENT_PROVIDER="razorpay"

# PAYMENT_ENV: Environment mode ("sandbox" or "production")
PAYMENT_ENV="sandbox"

# PAYMENT_KEY_ID: Public Key ID (e.g. rzp_test_... or rzp_live_...)
PAYMENT_KEY_ID=""

# PAYMENT_KEY_SECRET: Server-Side Secret Key (Never expose to frontend)
PAYMENT_KEY_SECRET=""

# PAYMENT_WEBHOOK_SECRET: Secret for HMAC-SHA256 signature verification of incoming gateway webhooks
PAYMENT_WEBHOOK_SECRET=""

# PAYMENT_PROVIDER_KEY: Legacy alias for PAYMENT_KEY_ID
PAYMENT_PROVIDER_KEY=""

# META_APP_ID: Meta App ID for Facebook and Instagram Graph API
META_APP_ID=""

# META_APP_SECRET: Meta App Secret for Facebook and Instagram Graph API
META_APP_SECRET=""

# META_REDIRECT_URI: Meta OAuth redirect callback URI
META_REDIRECT_URI="/api/meta/oauth/callback"

# META_API_VERSION: Meta Graph API version
META_API_VERSION="v21.0"

# JWT_SECRET: Secret key for signing session tokens
JWT_SECRET="smap_jwt_secure_secret_key_change_in_production"
